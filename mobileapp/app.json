    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#ffffff"
      },
      "package": "com.yourcompany.adminapp"
    },
    "web": {
      "bundler": "metro"
    },
    "extra": {
      "eas": {
        "projectId": "b2372b2b-d6f5-4d2f-9b0d-5a8cac0dc9bb"
      }
    }
  }
}
